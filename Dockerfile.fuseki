# syntax=docker/dockerfile:1.7

# RDF Delta has no published release compatible with Jena 6.x (the last Maven
# Central release, 1.1.2, predates Jena 6). The upstream maintainer has also
# announced the separate rdf-delta project will eventually be archived, so
# this pins an exact commit known to build and work against Jena 6.2.0
# instead of tracking a branch that could move or disappear upstream.
ARG RDF_DELTA_REF=0a44c60368c523361fd2ba1d929023e5f1987ee0

FROM maven:3.9.11-eclipse-temurin-21 AS build
ARG RDF_DELTA_REF

WORKDIR /build
RUN git clone --quiet https://github.com/afs/rdf-delta.git . \
    && git checkout --quiet "${RDF_DELTA_REF}"

RUN --mount=type=cache,target=/root/.m2,sharing=locked \
    mvn -q -DskipTests -pl rdf-delta-fuseki-server -am install

FROM eclipse-temurin:21-jre-jammy AS fuseki

ENV FUSEKI_BASE=/fuseki

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl tini

COPY --from=build /build/rdf-delta-fuseki-server/target/rdf-delta-fuseki-server-*.jar /fuseki/delta-fuseki.jar
COPY docker/fuseki/entrypoint.sh /usr/local/bin/fuseki-entrypoint

RUN chmod +x /usr/local/bin/fuseki-entrypoint \
    && mkdir -p "${FUSEKI_BASE}/config" "${FUSEKI_BASE}/zone" \
    && groupadd --system --gid 10001 fuseki \
    && useradd --system --uid 10001 --gid fuseki --home-dir "${FUSEKI_BASE}" fuseki \
    && chown -R fuseki:fuseki "${FUSEKI_BASE}"

USER fuseki
WORKDIR ${FUSEKI_BASE}
EXPOSE 3030
HEALTHCHECK --interval=20s --timeout=5s --start-period=45s --retries=6 \
    CMD curl -fsS 'http://127.0.0.1:3030/$/ping' >/dev/null || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/fuseki-entrypoint"]
CMD ["--port", "3030", "--conf", "/fuseki/config/config.ttl"]
